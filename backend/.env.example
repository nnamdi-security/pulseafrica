# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://pulseafrica:pulseafrica@localhost:5432/pulseafrica

# Required. The API, Alembic and the scripts refuse to start without a key of 32+ bytes.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# "production" turns off the API docs, adds HSTS and requires https CORS origins
ENVIRONMENT=development
LOG_LEVEL=INFO

# Limits on login, register and password checks (docs/decisions/0009). Leave on outside the browser tests.
RATE_LIMITING=true
# Comma-separated addresses of reverse proxies whose X-Forwarded-For header gives the client address
TRUSTED_PROXIES=
